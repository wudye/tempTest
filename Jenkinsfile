pipeline {    agent any    stages {        stage('Checkout') {            steps {                git url: 'https://github.com/wudye/tempTest.git', branch: 'main', credentialsId: '762946a6-e653-4f9a-b7cc-425c7ffbfb02'            }        }        stage('Build') {            steps {                script {                    if (isUnix()) {                        sh 'mvn -B -DskipTests package'                    } else {                        bat 'mvn -B -DskipTests package'                    }                }            }        }        stage('Test') {            steps {                script {                    if (isUnix()) {                        sh 'mvn -B test'                    } else {                        bat 'mvn -B test'                    }                }            }        }        stage('Publish Test Results') {            steps {                junit 'target/surefire-reports/*.xml'                archiveArtifacts artifacts: 'target/*.jar', allowEmptyArchive: true            }        }    }}