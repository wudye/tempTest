pipeline {    agent any    stages {        stage('Checkout') {            steps {                git url: 'https://github.com/wudye/tempTest.git', branch: 'main', credentialsId: '762946a6-e653-4f9a-b7cc-425c7ffbfb02'            }        }        stage('Build') {            steps {                dir('microservicedemo') {                    script {                        if (isUnix()) {                            sh 'mvn -B -DskipTests package'                        } else {                            bat 'mvn -B -DskipTests package'                        }                    }                }            }        }        stage('Test') {            steps {                dir('microservicedemo') {                    script {                        if (isUnix()) {                            sh 'mvn -B test'                        } else {                            bat 'mvn -B test'                        }                    }                }            }        }        stage('Publish Test Results') {            steps {                junit testResults: 'microservicedemo/target/surefire-reports/*.xml', allowEmptyResults: true                archiveArtifacts artifacts: 'microservicedemo/target/*.jar', allowEmptyArchive: true            }        }    }}