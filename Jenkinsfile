pipeline {    agent any    tools {        maven 'Maven3'    }    stages {        stage('Checkout') {            steps {                // 使用仓库根地址（HTTPS 或 SSH），分支为 main，credentialsId 为你在 Jenkins 中添加的凭据 ID                git url: 'https://github.com/wudye/tempTest', branch: 'main', credentialsId: 'github-creds'            }        }        stage('Build') {            steps {                sh 'mvn clean package -DskipTests'            }        }        stage('Test') {            steps {                sh 'mvn clean test'            }        }        stage('Publish Test Results') {           steps {               // 发布 surefire/ failsafe 生成的 xml 报表               junit 'target/surefire-reports/*.xml'               archiveArtifacts artifacts: 'target/*.jar', allowEmptyArchive: true           }        }    }}