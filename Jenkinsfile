pipeline {    agent any    tools {        maven 'Maven3'    }    stages {        stage('Checkout') {            steps {                // 使用仓库根地址（HTTPS 或 SSH），分支为 main，credentialsId 为你在 Jenkins 中添加的凭据 ID                git url: 'https://github.com/wudye/spring-microservice-template/tree/main/update%20to%20v2/template_v2', branch: 'main', credentialsId: 'github-creds'            }        }        stage('Build') {            steps {                sh 'mvn -B clean package'            }        }        stage('Post') {            steps {                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true                junit 'target/surefire-reports/*.xml'            }        }    }}