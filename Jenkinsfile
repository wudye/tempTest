pipeline {    agent any    tools {        maven 'Maven3'    }    stages {        stage('Checkout') {            steps {                git url: 'https://github.com/wudye/tempTest.git', branch: 'main', credentialsId: '762946a6-e653-4f9a-b7cc-425c7ffbfb02'            }        }        stage('Build') {            steps {                bat 'mvn -B -DskipTests package'            }        }        stage('Test') {            steps {                bat 'mvn -B test'            }        }        stage('Publish Test Results') {           steps {               junit 'target/surefire-reports/*.xml'               archiveArtifacts artifacts: 'target/*.jar', allowEmptyArchive: true           }        }    }}